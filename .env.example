# Copy to `.env.local` and replace the placeholders with real values.
# `.env*` is gitignored; this example file is force-added on purpose.

# Canonical site origin used for server-side absolute URLs (Polar successUrl,
# returnUrl, etc.). Set this in local dev so checkout redirects come back here.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Polar.sh billing -------------------------------------------------------
# Billing is scaffolded but NOT live. The values below are deliberately spoofed
# placeholders so nothing can transact before the 0.5.0 Private Beta.
#
# Going live also requires flipping POLAR_BILLING_ENABLED to true in
# `lib/feature-flags.ts`. See "Polar.sh Integration" in AGENTS.md.

# Organization access token from Polar (Settings > Developers > New Token).
POLAR_ACCESS_TOKEN="polar_oat_SPOOFED_PLACEHOLDER_NOT_A_REAL_TOKEN"

# Webhook signing secret from Polar (Settings > Webhooks > your endpoint).
POLAR_WEBHOOK_SECRET="polar_whs_SPOOFED_PLACEHOLDER_NOT_A_REAL_SECRET"

# Product id backing the $10/month Pro plan shown on /pricing.
POLAR_PRO_PRODUCT_ID="00000000-0000-0000-0000-000000000000"

# "sandbox" (default) or "production". Stays on sandbox unless set explicitly
# so a stray token cannot charge anyone.
POLAR_SERVER="sandbox"
