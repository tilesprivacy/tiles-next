# Cloudflare Turnstile site key for the newsletter form. Empty skips the challenge (local dev).
PUBLIC_TURNSTILE_SITE_KEY=
# Canonical origin. Defaults to https://www.tiles.run; use http://localhost:5173 in dev.
PUBLIC_SITE_URL=

# Everything below is server-only. `vite dev` reads this file as .env;
# `wrangler dev` reads the same names from .dev.vars. In production set them
# with `wrangler secret put NAME` (or in the Cloudflare dashboard).

# Resend API key for the newsletter welcome email (re_...).
RESEND_API_KEY=
# Sender address, e.g. newsletter@tiles.run. Defaults to Resend's onboarding address.
RESEND_FROM_EMAIL=
# Resend audience that newsletter signups are stored in. Required in production.
RESEND_AUDIENCE_ID=
# Cloudflare Turnstile secret key. Required in production; empty skips the check in dev.
TURNSTILE_SECRET_KEY=
# Upstash Redis for the signup rate limits. Required in production; dev falls back to memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Polar organization access token (polar_oat_...). Enables session-mode checkout.
POLAR_ACCESS_TOKEN=
# Polar webhook signing secret (polar_whs_...). Webhooks stay off without it.
POLAR_WEBHOOK_SECRET=
# "production" (default) or "sandbox".
POLAR_SERVER=
# Override the committed Polar Checkout Links or product ids, e.g. for a preview build.
POLAR_PRO_CHECKOUT_LINK=
POLAR_PLUS_CHECKOUT_LINK=
POLAR_PRO_PRODUCT_ID=
POLAR_PLUS_PRODUCT_ID=

# GitHub token for release and star lookups. Optional; raises the API rate limit.
GITHUB_TOKEN=
