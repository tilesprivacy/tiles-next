# Copy to `.env.local` and replace the placeholders with real values.
# `.env*` is gitignored; this example file is force-added on purpose.

# Canonical site origin used for server-side absolute URLs (Polar successUrl,
# returnUrl, etc.). Set this in local dev so checkout redirects come back here.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Polar.sh billing -------------------------------------------------------
# Billing is enabled in code (POLAR_BILLING_ENABLED in lib/feature-flags.ts).
# The Subscribe action on /pricing opens Polar's embedded checkout, and needs
# EITHER of the following. With neither, it renders disabled and fails closed.
#
#   1. POLAR_PRO_CHECKOUT_LINK below (or the committed constant in
#      lib/polar.ts). Public URL, no secret, simplest option.
#   2. POLAR_ACCESS_TOKEN, which lets the browser mint a checkout session on
#      click via /api/polar/checkout/session.
#
# See "Polar.sh Integration" in AGENTS.md.

# Public Polar Checkout Link for Tiles Pro. Create it in the Polar dashboard
# under Checkout Links > New Link and select the Tiles Pro product. This is a
# public URL and is safe to commit in lib/polar.ts instead of setting it here.
# POLAR_PRO_CHECKOUT_LINK="https://buy.polar.sh/polar_cl_xxxxxxxxxxxx"

# Organization access token from Polar (Settings > Developers > New Token).
# Needed for the session-based checkout fallback and for direct API calls.
POLAR_ACCESS_TOKEN="polar_oat_SPOOFED_PLACEHOLDER_NOT_A_REAL_TOKEN"

# Webhook signing secret from Polar (Settings > Webhooks > your endpoint).
# Required for /api/polar/webhooks.
POLAR_WEBHOOK_SECRET="polar_whs_SPOOFED_PLACEHOLDER_NOT_A_REAL_SECRET"

# Optional. The live Tiles Pro product id is committed as the default in
# lib/polar.ts; set this only to point a preview build at a different product.
# POLAR_PRO_PRODUCT_ID="98d19697-7811-437f-933e-c5a55caa9362"

# Optional. Defaults to "production". Set to "sandbox" for test checkouts.
# POLAR_SERVER="sandbox"
