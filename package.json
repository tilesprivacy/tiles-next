{
  "name": "tiles-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*",
    "#content/*": "./content/*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "build": "node scripts/og-images.ts && vite build && pagefind --site .svelte-kit/cloudflare --output-subdir _pagefind",
    "search:index": "npm run build && pagefind --site .svelte-kit/cloudflare --output-path static/_pagefind",
    "preview": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "deploy": "npm run build && wrangler deploy",
    "blog:publish": "node scripts/publish-blog.ts",
    "blog:dry-run": "node scripts/publish-blog.ts --dry-run",
    "serve:install": "npm --prefix serve install",
    "serve:deploy": "npm --prefix serve run deploy",
    "serve:upload-latest-pkg": "npm --prefix serve run upload:latest-pkg",
    "serve:upload-file": "npm --prefix serve run upload:file --"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@polar-sh/checkout": "0.4.3",
    "@resvg/resvg-wasm": "2.4.0",
    "clsx": "2.1.1",
    "hast-util-raw": "9.1.0",
    "hast-util-sanitize": "5.0.2",
    "katex": "0.16.47",
    "mdast-util-math": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "qrcode": "1.5.4",
    "resend": "6.34.1",
    "satori-og": "npm:satori@0.25.0",
    "tailwind-merge": "3.7.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/svelte": "1.59.0",
    "@polar-sh/sdk": "1.0.2",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "github-slugger": "2.0.0",
    "hast-util-to-html": "9.0.6",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-string": "4.0.0",
    "mdsvex": "0.12.8",
    "micromark-extension-gfm": "3.0.0",
    "pagefind": "1.5.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "satori": "0.62.0",
    "shiki": "4.5.0",
    "simple-icons": "16.35.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  }
}
