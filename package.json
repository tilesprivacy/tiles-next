{
  "name": "tiles-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*",
    "#content/*": "./content/*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/og-images.ts && vite build && pagefind --site .svelte-kit/cloudflare --output-subdir _pagefind",
    "preview": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "deploy": "npm run build && wrangler deploy",
    "blog:publish": "npx --yes sequoia-cli@0.5.7 publish",
    "blog:dry-run": "npx --yes sequoia-cli@0.5.7 publish --dry-run --verbose"
  },
  "dependencies": {
    "@polar-sh/checkout": "0.4.3",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "resend": "6.34.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/svelte": "1.59.0",
    "@polar-sh/sdk": "1.0.2",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "github-slugger": "2.0.0",
    "mdsvex": "0.12.8",
    "pagefind": "1.5.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "satori": "0.62.0",
    "shiki": "4.5.0",
    "simple-icons": "16.35.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  }
}
