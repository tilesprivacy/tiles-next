{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tiles-site",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // No not_found_handling: with "404-page", browser navigations that don't
  // match a static file get the 404 page without the Worker ever running,
  // which breaks every server-rendered route (/download, /releases, ...).
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  // The site's domains. Routes take over the existing proxied DNS records for
  // these hostnames without changing DNS. tiles.run should redirect to www
  // (a Redirect Rule in the Cloudflare dashboard, which runs before Workers).
  "routes": [
    { "pattern": "www.tiles.run/*", "zone_name": "tiles.run" },
    { "pattern": "tiles.run/*", "zone_name": "tiles.run" }
  ],
  // Only serve the site at tiles.run, not also at *.workers.dev addresses.
  "workers_dev": false,
  "preview_urls": false,
  // Newsletter abuse limits (hashed keys only). Schema in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiles-site",
      "database_id": "16da3fe8-6b03-4d8d-acbb-35386dcb58da",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
  // Secrets (set with `wrangler secret put NAME`, never committed):
  //   RESEND_API_KEY, RESEND_FROM_EMAIL, RESEND_SEGMENT_ID, NEWSLETTER_TOKEN_KEY,
  //   TURNSTILE_SECRET_KEY,
  //   POLAR_ACCESS_TOKEN, POLAR_WEBHOOK_SECRET
}
